---
// Kontaktlänkar från material/texter.md
const links = [
  {
    label: 'E-mail mats@mawini.com',
    href: 'mailto:mats@mawini.com',
    icon: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  },
  {
    label: 'Call +46 732 622 660',
    href: 'tel:+46732622660',
    icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  },
  {
    label: 'Instagram',
    href: 'https://instagram.com/mawini.studio/',
    icon: '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/mats-w-nilsson-a73b632/',
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  },
];
---

<ul class="contact">
  {
    links.map(({ label, href, icon }) => (
      <li>
        <a
          href={href}
          aria-label={label}
          title={label}
          {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
        >
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icon}
          />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .contact {
    display: flex;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    padding: 2px;
    color: var(--muted);
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: var(--accent);
  }

  svg {
    display: block;
  }
</style>
