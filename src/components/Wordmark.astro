---
// Logotypen "mawini studio" från material/logo/mawini-studio-a.svg.
// Konturerna är tunna pixellinjer (6,9 enheter i en 2160 enheter bred
// viewBox). För att de ska bli skarpa avrundas pathen vid bygget till
// pixelrutnätet för den storlek den visas i (se src/lib/pixel-path.ts):
// - 313 px bred: linjen blir exakt 1 px, kanterna på hela pixlar
//   (skarpt på 1x, 2x och 3x)
// - Smala skärmar (≤ 420 px), 3x (de flesta mobiler): 209 px bred, linjen
//   blir 2/3 px = exakt 2 enhetspixlar, kanterna på tredjedels pixlar
// - Smala skärmar, 2x (t.ex. iPhone SE): 156,5 px bred, linjen blir 0,5 px =
//   exakt 1 enhetspixel. (209 px gav här ojämna linjer, 1 eller 2 pixlar.)
import logoSvg from '../../material/logo/mawini-studio-a.svg?raw';
import { snapPath } from '../lib/pixel-path';

interface Props {
  label: string;
}

const { label } = Astro.props;

const d = logoSvg.match(/<path[^>]*\sd="([^"]+)"/)?.[1];
const viewBox = logoSvg.match(/viewBox="([^"]+)"/)?.[1].split(/[\s,]+/).map(Number);
if (!d || !viewBox) throw new Error('mawini-studio-a.svg: hittar ingen path eller viewBox');
const [, , vbWidth, vbHeight] = viewBox;

const sizes = [
  { name: 'wide', width: 313, grid: 1 },
  { name: 'narrow', width: 209, grid: 1 / 3 },
  { name: 'narrow-2x', width: 156.5, grid: 1 / 2 },
].map(({ name, width, grid }) => {
  const scale = width / vbWidth;
  const height = Math.round((vbHeight * scale) / grid) * grid;
  return { name, width, height: Number(height.toFixed(4)), d: snapPath(d, scale, grid) };
});
---

<a class="wordmark-link" href="#top" aria-label={label}>
  {
    sizes.map(({ name, width, height, d }) => (
      <svg
        class={`wordmark-logo wordmark-logo--${name}`}
        width={width}
        height={height}
        viewBox={`0 0 ${width} ${height}`}
        shape-rendering="crispEdges"
        aria-hidden="true"
        focusable="false"
      >
        <path fill="#ff4600" d={d} />
      </svg>
    ))
  }
</a>

<style>
  .wordmark-link {
    display: block;
    text-decoration: none;
  }

  .wordmark-logo {
    display: block;
  }

  .wordmark-logo--narrow,
  .wordmark-logo--narrow-2x {
    display: none;
  }

  @media (max-width: 420px) {
    .wordmark-logo--wide {
      display: none;
    }

    .wordmark-logo--narrow {
      display: block;
    }
  }

  @media (max-width: 420px) and (max-resolution: 2.4dppx) {
    .wordmark-logo--narrow {
      display: none;
    }

    .wordmark-logo--narrow-2x {
      display: block;
    }
  }
</style>
