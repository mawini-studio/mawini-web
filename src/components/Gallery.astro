---
import { Image, getImage } from 'astro:assets';
import { gallery, imageFor } from '../data/gallery';

// Justified grid: varje bild får flex-grow och flex-basis i proportion till
// sitt bildformat, så alla bilder på en rad får samma höjd.
const items = await Promise.all(
  gallery.map(async (item) => {
    const src = imageFor(item);
    const full = await getImage({ src, width: Math.min(src.width, 2000), format: 'webp' });
    const caption = [item.title, item.client, item.year].filter(Boolean).join(' · ');
    return { item, src, full, caption, ratio: src.width / src.height };
  }),
);
---

<section class="gallery" aria-label="Selected work">
  <ul class="grid">
    {
      items.map(({ item, src, full, caption, ratio }, i) => (
        <li style={`--ar: ${ratio.toFixed(4)}`}>
          <a
            href={full.src}
            data-index={i}
            data-full={full.src}
            data-caption={caption || undefined}
            data-category={item.category}
          >
            <Image
              src={src}
              alt={item.alt}
              widths={[400, 700, 1000, 1400]}
              sizes="(max-width: 640px) 60vw, 360px"
              loading={i < 6 ? 'eager' : 'lazy'}
            />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<dialog class="lightbox" aria-label="Image viewer">
  <figure>
    <img alt="" />
    <figcaption hidden></figcaption>
  </figure>
  <button class="lb-btn lb-close" type="button" aria-label="Close">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
  </button>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous image">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4l-8 8 8 8"></path></svg>
  </button>
  <button class="lb-btn lb-next" type="button" aria-label="Next image">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8"></path></svg>
  </button>
</dialog>

<style>
  .grid {
    --row-h: 260px;
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Hindrar sista raden från att sträckas ut */
  .grid::after {
    content: '';
    flex-grow: 1000000;
  }

  .grid li {
    flex: var(--ar) 1 calc(var(--ar) * var(--h, var(--row-h)));
    min-width: 0;
    margin-bottom: var(--gap);
  }

  /* Radbrytning som sätts av skriptet nedan */
  .grid :global(li.break) {
    flex: 0 0 100%;
    height: 0;
    margin: 0;
  }

  .grid a {
    display: block;
    background: #f2f2f2;
  }

  .grid img {
    width: 100%;
    height: auto;
    aspect-ratio: var(--ar);
    transition: opacity 0.2s;
  }

  .grid a:hover img,
  .grid a:focus-visible img {
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .grid {
      --row-h: 220px;
    }
  }

  @media (max-width: 640px) {
    .grid {
      --row-h: 190px;
    }
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    overscroll-behavior: contain;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: lb-fade 0.18s ease-out;
  }

  @keyframes lb-fade {
    from {
      opacity: 0;
    }
  }

  figure {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    touch-action: pan-y;
  }

  figure img {
    max-width: calc(100vw - 8rem);
    max-height: calc(100dvh - 6rem);
    width: auto;
    height: auto;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  figcaption {
    font-size: 0.875rem;
    font-family: var(--mono);
    color: #555;
  }

  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .lb-btn:hover,
  .lb-btn:focus-visible {
    color: var(--accent);
  }

  .lb-btn svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .lb-close {
    top: 0.75rem;
    right: 0.75rem;
  }

  .lb-prev,
  .lb-next {
    top: 50%;
    translate: 0 -50%;
  }

  .lb-prev {
    left: 0.75rem;
  }

  .lb-next {
    right: 0.75rem;
  }

  @media (max-width: 640px) {
    figure img {
      max-width: 100vw;
      max-height: calc(100dvh - 8rem);
    }

    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
  }

  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }
</style>

<script>
  // Radbrytningar för det justerade gridet. Utan skript bryter flexbox raderna
  // girigt, vilket kan ge enstaka mycket höga rader. Här väljs brytpunkten så
  // att varje rads höjd hamnar så nära --row-h som möjligt. Radens höjd sätts
  // som --h så att flex-basis summerar till exakt en rad (flexbox radbryter
  // på flex-basis, före krympning).
  const grid = document.querySelector<HTMLUListElement>('.grid')!;
  const tiles = [...grid.querySelectorAll<HTMLLIElement>(':scope > li:not(.break)')];

  function setRow(from: number, to: number, height: number) {
    // Avrunda nedåt så att avrundningsfel aldrig skickar sista bilden till nästa rad
    const h = `${Math.floor(height * 10) / 10 - 0.1}px`;
    for (let k = from; k <= to; k++) tiles[k].style.setProperty('--h', h);
  }

  function layout() {
    grid.querySelectorAll(':scope > li.break').forEach((el) => el.remove());
    tiles.forEach((li) => li.style.removeProperty('--h'));
    const style = getComputedStyle(grid);
    const width = grid.clientWidth;
    const target = parseFloat(style.getPropertyValue('--row-h'));
    const gap = parseFloat(style.columnGap) || 0;
    const ratios = tiles.map((li) => parseFloat(li.style.getPropertyValue('--ar')));

    const heightOf = (sum: number, n: number) => (width - gap * (n - 1)) / sum;
    let start = 0;
    let sum = 0;
    for (let i = 0; i < tiles.length; i++) {
      sum += ratios[i];
      const n = i - start + 1;
      if (sum * target + gap * (n - 1) < width) continue;
      let end = i;
      let height = heightOf(sum, n);
      if (n > 1) {
        const withoutLast = heightOf(sum - ratios[i], n - 1);
        if (Math.abs(withoutLast - target) < Math.abs(height - target)) {
          end = i - 1;
          height = withoutLast;
        }
      }
      setRow(start, end, height);
      const br = document.createElement('li');
      br.className = 'break';
      br.setAttribute('aria-hidden', 'true');
      tiles[end].after(br);
      start = end + 1;
      sum = end === i ? 0 : ratios[i];
    }
  }

  layout();
  let lastWidth = grid.clientWidth;
  new ResizeObserver(() => {
    if (grid.clientWidth !== lastWidth) {
      lastWidth = grid.clientWidth;
      layout();
    }
  }).observe(grid);

  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector('img')!;
  const caption = dialog.querySelector('figcaption')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.grid a[data-full]')];
  let current = 0;

  function preload(i: number) {
    const link = links[(i + links.length) % links.length];
    new Image().src = link.dataset.full!;
  }

  function show(i: number) {
    current = (i + links.length) % links.length;
    const link = links[current];
    const thumb = link.querySelector('img')!;
    img.src = link.dataset.full!;
    img.alt = thumb.alt;
    const text = link.dataset.caption ?? '';
    caption.textContent = text;
    caption.hidden = !text;
    preload(current + 1);
    preload(current - 1);
  }

  links.forEach((link, i) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
      dialog.showModal();
    });
  });

  dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));
  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());

  // Klick utanför bilden stänger
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  // Esc hanteras av <dialog>; pilar här
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // Återställ fokus till bilden i gridet när lightboxen stängs
  dialog.addEventListener('close', () => {
    links[current].focus({ preventScroll: true });
    links[current].scrollIntoView({ block: 'nearest' });
  });

  // Swipe
  let startX = 0;
  let startY = 0;
  dialog.addEventListener(
    'touchstart',
    (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    },
    { passive: true },
  );
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    const dy = e.changedTouches[0].clientY - startY;
    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
      show(dx < 0 ? current + 1 : current - 1);
    }
  });
</script>
