---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { texter, inline } from '../data/texter';

// Bilderna och deras ordning kommer från src/content/galleri.yaml
const gallery = (await getCollection('galleri'))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);

// Astros file-loader loggar bara ett fel om YAML-filen inte går att läsa,
// och bygget skulle då publicera ett tomt galleri. Stoppa bygget i stället.
if (gallery.length === 0) {
  throw new Error(
    'galleri.yaml: inga bilder hittades. Kontrollera att filen är giltig YAML (indrag, kolon, citattecken).',
  );
}

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

type GalleryImage = Extract<(typeof gallery)[number], { kind: 'image' }>;

async function prepare(item: Omit<GalleryImage, 'kind' | 'order'>) {
  const path = `../assets/gallery/${item.category}/${item.file}`;
  if (!images[path]) {
    throw new Error(`galleri.yaml: hittar inte src/assets/gallery/${item.category}/${item.file}`);
  }
  const src = images[path].default;
  const full = await getImage({ src, width: Math.min(src.width, 2000), format: 'webp' });
  const caption = [item.title, item.client, item.year].filter(Boolean).join(' · ');
  return { item, src, full, caption, ratio: src.width / src.height };
}

// Justified grid: varje ruta får flex-grow och flex-basis i proportion till
// sitt bildformat, så alla rutor på en rad får samma höjd.
// Ett bildpar är en kolumn med två bilder ovanpå varandra. Med radhöjden h
// och mellanrummet g blir kolumnens bredd k·(h − g), där k = 1 / (1/a₁ + 1/a₂),
// så att paret inklusive mellanrum blir exakt h högt utan beskärning.
const tiles = await Promise.all(
  gallery.map(async (entry) => {
    if (entry.kind === 'pair') {
      const images = await Promise.all(entry.pair.map(prepare));
      const k = 1 / images.reduce((sum, img) => sum + 1 / img.ratio, 0);
      return { kind: 'pair' as const, images, k, photo: images[0].item.category === 'photography' };
    }
    const image = await prepare(entry);
    return { kind: 'image' as const, images: [image], k: image.ratio, photo: image.item.category === 'photography' };
  }),
);

// Två sektioner: först allt som inte är foto, sedan foton.
// Ordningen inom varje sektion följer galleri.yaml.
const sections = [
  { id: 'design', heading: texter.gallery.design, tiles: tiles.filter((tile) => !tile.photo) },
  { id: 'photography', heading: texter.gallery.photography, tiles: tiles.filter((tile) => tile.photo) },
].filter((section) => section.tiles.length > 0);
---

<div class="gallery">
  {
    sections.map((section, s) => (
      <section id={section.id} class="gallery-section" aria-labelledby={`gallery-heading-${s}`}>
        <h2 class="section-heading gallery-heading" id={`gallery-heading-${s}`} set:html={inline(section.heading)} />
        <ul class="grid">
          {section.tiles.map((tile, i) => (
            <li
              class={tile.kind === 'pair' ? 'pair' : undefined}
              style={tile.kind === 'pair' ? `--k: ${tile.k.toFixed(4)}` : `--ar: ${tile.k.toFixed(4)}`}
            >
              {tile.images.map(({ item, src, full, caption, ratio }) => (
                <a
                  href={full.src}
                  style={tile.kind === 'pair' ? `--ar: ${ratio.toFixed(4)}` : undefined}
                  data-full={full.src}
                  data-ar={ratio.toFixed(4)}
                  data-caption={caption || undefined}
                  data-category={item.category}
                >
                  <Image
                    src={src}
                    alt={item.alt}
                    widths={[400, 700, 1000, 1400]}
                    sizes="(max-width: 640px) 60vw, 360px"
                    loading={s === 0 && i < 6 ? 'eager' : 'lazy'}
                  />
                </a>
              ))}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<dialog class="lightbox" aria-label="Image viewer">
  <div class="lb-stage">
    <figure>
      <div class="lb-stack">
        <img alt="" />
        <img alt="" hidden />
      </div>
      <figcaption hidden></figcaption>
    </figure>
  </div>
  <button class="lb-btn lb-close" type="button" aria-label="Close">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
  </button>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous image">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4l-8 8 8 8"></path></svg>
  </button>
  <button class="lb-btn lb-next" type="button" aria-label="Next image">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8"></path></svg>
  </button>
</dialog>

<style>
  /* 16 px mellan sista bildraden i design och rubriken photography
     (bildraderna har redan mellanrummet --gap under sig) */
  section + section .gallery-heading {
    margin-top: calc(1rem - var(--gap));
  }

  /* Samma sak mot linjen under galleriet: dra av sista radens --gap */
  .gallery {
    margin-bottom: calc(-1 * var(--gap));
  }

  .grid {
    --row-h: 260px;
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Hindrar sista raden från att sträckas ut */
  .grid::after {
    content: '';
    flex-grow: 1000000;
  }

  .grid li {
    flex: var(--ar) 1 calc(var(--ar) * var(--h, var(--row-h)));
    min-width: 0;
    margin-bottom: var(--gap);
  }

  /* Bildpar: kolumnbredd k·(h − g) ger total höjd h inklusive mellanrummet */
  .grid li.pair {
    flex: var(--k) 1 calc(var(--k) * (var(--h, var(--row-h)) - var(--gap)));
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  /* Radbrytning som sätts av skriptet nedan */
  .grid :global(li.break) {
    flex: 0 0 100%;
    height: 0;
    margin: 0;
  }

  .grid a {
    display: block;
    background: #f2f2f2;
  }

  .grid img {
    width: 100%;
    height: auto;
    aspect-ratio: var(--ar);
    transition: opacity 0.2s;
  }

  .grid a:hover img,
  .grid a:focus-visible img {
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .grid {
      --row-h: 220px;
    }
  }

  @media (max-width: 640px) {
    .grid {
      --row-h: 190px;
    }
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    overscroll-behavior: contain;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: lb-fade 0.18s ease-out;
  }

  @keyframes lb-fade {
    from {
      opacity: 0;
    }
  }

  /* Ytan som en bild eller ett bildpar skalas in i (marginal för knapparna) */
  .lb-stage {
    position: absolute;
    inset: 3rem 4rem;
    display: grid;
    place-items: center;
    touch-action: pan-y;
  }

  figure {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }

  /* En bild, eller ett par staplat med samma mellanrum som i gridet.
     Bredden sätts av skriptet så att allt ryms i .lb-stage. */
  .lb-stack {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  /* global.css sätter img { display: block }, som annars vinner över hidden */
  .lb-stack img[hidden] {
    display: none;
  }

  .lb-stack img {
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  figcaption {
    font-family: var(--mono);
    color: #555;
    text-align: center;
  }

  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .lb-btn:hover,
  .lb-btn:focus-visible {
    color: var(--accent);
  }

  .lb-btn svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .lb-close {
    top: 0.75rem;
    right: 0.75rem;
  }

  .lb-prev,
  .lb-next {
    top: 50%;
    translate: 0 -50%;
  }

  .lb-prev {
    left: 0.75rem;
  }

  .lb-next {
    right: 0.75rem;
  }

  @media (max-width: 640px) {
    .lb-stage {
      inset: 4rem 0;
    }

    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
  }

  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }
</style>

<script>
  // Radbrytningar för det justerade gridet. Utan skript bryter flexbox raderna
  // girigt, vilket kan ge enstaka mycket höga rader. Här väljs brytpunkten så
  // att varje rads höjd hamnar så nära --row-h som möjligt. Radens höjd sätts
  // som --h så att flex-basis summerar till exakt en rad (flexbox radbryter
  // på flex-basis, före krympning).
  function layout(grid: HTMLUListElement) {
    grid.querySelectorAll(':scope > li.break').forEach((el) => el.remove());
    const tiles = [...grid.querySelectorAll<HTMLLIElement>(':scope > li')];
    tiles.forEach((li) => li.style.removeProperty('--h'));
    const style = getComputedStyle(grid);
    const width = grid.clientWidth;
    const target = parseFloat(style.getPropertyValue('--row-h'));
    const gap = parseFloat(style.columnGap) || 0;
    // Ruta i bredd vid radhöjd h: ratio·h − offset. Enstaka bild: offset 0.
    // Bildpar: ratio k och offset k·g (mellanrummet mellan de två bilderna).
    const ratios = tiles.map((li) =>
      parseFloat(li.style.getPropertyValue(li.classList.contains('pair') ? '--k' : '--ar')),
    );
    const offsets = tiles.map((li, i) => (li.classList.contains('pair') ? ratios[i] * gap : 0));

    function setRow(from: number, to: number, height: number) {
      // Avrunda nedåt så att avrundningsfel aldrig skickar sista bilden till nästa rad
      const h = `${Math.floor(height * 10) / 10 - 0.1}px`;
      for (let k = from; k <= to; k++) tiles[k].style.setProperty('--h', h);
    }

    const heightOf = (sum: number, off: number, n: number) => (width - gap * (n - 1) + off) / sum;
    let start = 0;
    let sum = 0;
    let off = 0;
    for (let i = 0; i < tiles.length; i++) {
      sum += ratios[i];
      off += offsets[i];
      const n = i - start + 1;
      if (sum * target - off + gap * (n - 1) < width) continue;
      let end = i;
      let height = heightOf(sum, off, n);
      if (n > 1) {
        const withoutLast = heightOf(sum - ratios[i], off - offsets[i], n - 1);
        if (Math.abs(withoutLast - target) < Math.abs(height - target)) {
          end = i - 1;
          height = withoutLast;
        }
      }
      setRow(start, end, height);
      const br = document.createElement('li');
      br.className = 'break';
      br.setAttribute('aria-hidden', 'true');
      tiles[end].after(br);
      start = end + 1;
      sum = end === i ? 0 : ratios[i];
      off = end === i ? 0 : offsets[i];
    }
  }

  // Ett grid per sektion
  document.querySelectorAll<HTMLUListElement>('.grid').forEach((grid) => {
    layout(grid);
    let lastWidth = grid.clientWidth;
    new ResizeObserver(() => {
      if (grid.clientWidth !== lastWidth) {
        lastWidth = grid.clientWidth;
        layout(grid);
      }
    }).observe(grid);
  });

  // Lightboxen bläddrar genom gridets poster i sidans ordning, över sektionerna.
  // Ett bildpar är en post och visas staplat precis som i gridet.
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const stage = dialog.querySelector<HTMLElement>('.lb-stage')!;
  const stack = dialog.querySelector<HTMLElement>('.lb-stack')!;
  const imgs = [...stack.querySelectorAll('img')];
  const caption = dialog.querySelector('figcaption')!;

  interface Step {
    links: HTMLAnchorElement[];
    ratios: number[];
  }

  const steps: Step[] = [...document.querySelectorAll<HTMLLIElement>('.grid > li:not(.break)')].map((li) => {
    const links = [...li.querySelectorAll<HTMLAnchorElement>('a[data-full]')];
    return { links, ratios: links.map((a) => parseFloat(a.dataset.ar!)) };
  });
  let current = 0;

  function preload(i: number) {
    const step = steps[(i + steps.length) % steps.length];
    step.links.forEach((a) => (new Image().src = a.dataset.full!));
  }

  // Skala posten så att den ryms helt i .lb-stage. Med bredden W blir höjden
  // W/a för en bild och W/a₁ + g + W/a₂ för ett par.
  function fit() {
    const { ratios } = steps[current];
    const gap = parseFloat(getComputedStyle(stack).rowGap) || 0;
    const captionSpace = caption.hidden
      ? 0
      : caption.offsetHeight + (parseFloat(getComputedStyle(caption.parentElement!).rowGap) || 0);
    const maxW = stage.clientWidth;
    const maxH = stage.clientHeight - captionSpace;
    const inverse = ratios.reduce((sum, a) => sum + 1 / a, 0);
    const width = Math.max(0, Math.min(maxW, (maxH - gap * (ratios.length - 1)) / inverse));
    stack.style.width = `${Math.floor(width)}px`;
  }

  function show(i: number) {
    current = (i + steps.length) % steps.length;
    const { links, ratios } = steps[current];
    imgs.forEach((img, k) => {
      const link = links[k];
      img.hidden = !link;
      if (!link) {
        img.removeAttribute('src');
        return;
      }
      img.src = link.dataset.full!;
      img.alt = link.querySelector('img')!.alt;
      img.style.aspectRatio = String(ratios[k]);
    });
    const text = links
      .map((a) => a.dataset.caption)
      .filter(Boolean)
      .join(' / ');
    caption.textContent = text;
    caption.hidden = !text;
    fit();
    preload(current + 1);
    preload(current - 1);
  }

  steps.forEach((step, i) => {
    step.links.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        dialog.showModal();
        show(i);
      });
    });
  });

  window.addEventListener('resize', () => {
    if (dialog.open) fit();
  });

  dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));
  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());

  // Klick utanför bilderna stänger
  dialog.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (!target.closest('img, button, figcaption')) dialog.close();
  });

  // Esc hanteras av <dialog>; pilar här
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // Återställ fokus till posten i gridet när lightboxen stängs
  dialog.addEventListener('close', () => {
    const link = steps[current].links[0];
    link.focus({ preventScroll: true });
    link.scrollIntoView({ block: 'nearest' });
  });

  // Swipe
  let startX = 0;
  let startY = 0;
  dialog.addEventListener(
    'touchstart',
    (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    },
    { passive: true },
  );
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    const dy = e.changedTouches[0].clientY - startY;
    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
      show(dx < 0 ? current + 1 : current - 1);
    }
  });
</script>
