---
// Integritetspolicy för appen Naval Battle XTRM: https://mawini.com/navalbattle/privacy/
// Finns inte i menyn; nås bara via direktlänk (App Store m.fl.).
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { texter } from '../../../data/texter';
---

<Base
  title="Privacy Policy – Naval Battle XTRM"
  description="Privacy policy for the game Naval Battle XTRM by mawini studio. The game collects no personal data."
  imageAlt={texter.meta.imageAlt}
>
  <main class="card">
    <SiteHeader />

    <hr />

    <article class="policy">
      <h1>Naval Battle XTRM – Privacy Policy</h1>
      <p class="effective">Effective date: <time datetime="2026-11-24">24 November 2026</time></p>

      <p>
        Naval Battle XTRM is developed by Mats W Nilsson (mawini studio). This policy explains how the game handles
        your information.
      </p>

      <h2 class="section-heading">No data collection</h2>
      <p>
        Naval Battle XTRM does not collect, store or share any personal data. The game has no user accounts, no
        advertising, no analytics and no tracking, and it does not connect to the internet.
      </p>

      <h2 class="section-heading">Data stored on your device</h2>
      <p>
        Your game settings, match history and statistics are saved only on your own device so the game can remember
        them between sessions. This information never leaves your device and is not accessible to us. Deleting the app
        removes it.
      </p>

      <h2 class="section-heading">Third parties</h2>
      <p>The game contains no third-party services, SDKs or advertising networks.</p>

      <h2 class="section-heading">Children</h2>
      <p>
        The game is suitable for all ages and does not knowingly collect any information from anyone, including
        children.
      </p>

      <h2 class="section-heading">Changes to this policy</h2>
      <p>If this policy changes, the updated version will be published on this page with a new effective date.</p>

      <h2 class="section-heading">Contact</h2>
      <p>Questions about this policy: <a href="mailto:mats@mawini.com">mats@mawini.com</a></p>
    </article>

    <hr />

    <SiteFooter />
  </main>
</Base>

<style>
  /* Samma radlängd som om-texten på startsidan */
  .policy {
    max-width: 40rem;
  }

  /* Rubriken i samma storlek som ordmärket, normal vikt som övriga rubriker */
  h1 {
    margin: 0 0 0.375rem;
    font-size: var(--wordmark-size);
    font-weight: 400;
    line-height: inherit;
  }

  .effective {
    color: #555;
  }

  p {
    margin: 0 0 1rem;
  }

  /* Sista stycket: ingen egen marginal, så att luften ner till linjen blir 16 px */
  p:last-child {
    margin-bottom: 0;
  }
</style>
