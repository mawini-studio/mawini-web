---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import ContactIcons from '../components/ContactIcons.astro';
import Gallery from '../components/Gallery.astro';
import { texter, About, inline } from '../data/texter';
import { toRoman } from '../lib/roman';

// {year} i sidfoten: året vid bygget, uppdateras i webbläsaren (se skriptet nedan)
const footer = inline(texter.footer).replace(
  '{year}',
  `<span data-roman-year>${toRoman(new Date().getFullYear())}</span>`,
);
---

<Base title={texter.meta.title} description={texter.meta.description}>
  <main class="card">
    <header class="site-header">
      <h1 class="wordmark" set:html={inline(texter.wordmark)} />
      <Logo size={64} />
    </header>

    <hr />

    <section class="intro">
      <p class="tagline" set:html={inline(texter.tagline)} />
      <p class="categories" set:html={inline(texter.categories)} />
      <ContactIcons contact={texter.contact} />
    </section>

    <hr />

    <Gallery />

    <hr />

    <section class="about" id="about" aria-label="About">
      <About />
    </section>

    <hr />

    <footer class="site-footer">
      <p set:html={footer} />
    </footer>
  </main>
</Base>

<script>
  import { toRoman } from '../lib/roman';

  // Visa besökarens innevarande år och byt vid midnatt på nyårsafton i
  // besökarens tidszon, även om sidan står öppen över årsskiftet.
  const MAX_DELAY = 2 ** 31 - 1; // setTimeout klarar högst ca 24,8 dygn

  function update() {
    const year = new Date().getFullYear();
    document.querySelectorAll('[data-roman-year]').forEach((el) => {
      el.textContent = toRoman(year);
    });
    waitForNewYear(year + 1);
  }

  function waitForNewYear(nextYear: number) {
    const delay = new Date(nextYear, 0, 1).getTime() - Date.now();
    if (delay <= 0) return update();
    setTimeout(() => (delay > MAX_DELAY ? waitForNewYear(nextYear) : update()), Math.min(delay, MAX_DELAY));
  }

  update();
</script>

<style>
  .card {
    max-width: 1080px;
    margin: clamp(1rem, 4vw, 3.5rem) auto;
    padding: clamp(1.25rem, 4vw, 3rem);
    /* Samma luft ovanför loggan som mellan loggan och linjen (hr-marginalen) */
    padding-top: 2rem;
    background: var(--paper);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .wordmark {
    margin: 0;
    font-family: var(--mono);
    font-weight: 400;
    font-size: var(--wordmark-size);
    letter-spacing: 0.35em;
    text-transform: lowercase;
  }

  .tagline {
    margin: 0;
    font-weight: 600;
  }

  /* Halva luften (16 px) mellan linjerna och introt: under första linjen
     och ovanför linjen efter kontaktikonerna. Luften mellan loggan och
     första linjen är kvar på 32 px. */
  hr:has(+ .intro) {
    margin-bottom: 1rem;
  }

  .intro + hr {
    margin-top: 1rem;
  }

  /* Länkarna i kategoriraden ser ut som texten och blir orange vid hover/fokus */
  .categories :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .categories :global(a:hover),
  .categories :global(a:focus-visible) {
    color: var(--accent);
  }

  .categories {
    margin: 0.4rem 0 1.4rem;
    color: #555;
  }

  .about {
    max-width: 40rem;
  }

  .about :global(p) {
    margin: 0 0 1rem;
  }

  .site-footer p {
    margin: 0;
    font-family: var(--mono);
    letter-spacing: 0.15em;
    color: #555;
  }
</style>
