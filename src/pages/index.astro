---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import ContactIcons from '../components/ContactIcons.astro';
import Gallery from '../components/Gallery.astro';
import { texter, About, inline } from '../data/texter';
---

<Base title={texter.meta.title} description={texter.meta.description}>
  <main class="card">
    <header class="site-header">
      <h1 class="wordmark" set:html={inline(texter.wordmark)} />
      <Logo size={64} />
    </header>

    <section class="intro">
      <p class="tagline" set:html={inline(texter.tagline)} />
      <p class="categories" set:html={inline(texter.categories)} />
      <ContactIcons contact={texter.contact} />
    </section>

    <hr />

    <Gallery />

    <hr />

    <section class="about" aria-label="About">
      <About />
    </section>

    <hr />

    <footer class="site-footer">
      <p set:html={inline(texter.footer)} />
    </footer>
  </main>
</Base>

<style>
  .card {
    max-width: 1080px;
    margin: clamp(1rem, 4vw, 3.5rem) auto;
    padding: clamp(1.25rem, 4vw, 3rem);
    background: var(--paper);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .wordmark {
    margin: 0;
    font-family: var(--mono);
    font-weight: 400;
    font-size: var(--wordmark-size);
    letter-spacing: 0.35em;
    text-transform: lowercase;
  }

  .intro {
    margin-top: clamp(2rem, 6vw, 3.5rem);
  }

  .tagline {
    margin: 0;
    font-weight: 600;
  }

  .categories {
    margin: 0.4rem 0 1.4rem;
    color: #555;
  }

  .about {
    max-width: 40rem;
  }

  .about :global(p) {
    margin: 0 0 1rem;
  }

  .site-footer p {
    margin: 0;
    font-family: var(--mono);
    letter-spacing: 0.15em;
    color: #555;
  }
</style>
