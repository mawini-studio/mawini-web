---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  imageAlt: string;
}

const { title, description, imageAlt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Delningsbild för Open Graph/Twitter: public/og-image.png, 1200×630.
// Absolut adress (https://mawini.com/og-image.png), som tjänsterna kräver.
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ff4600" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {
      // Bara på dev-servern: ?bg=a / ?bg=b växlar bakgrundstonen (global.css)
      import.meta.env.DEV && (
        <script
          is:inline
          set:html={`const bg = new URLSearchParams(location.search).get('bg');
          if (bg === 'a' || bg === 'b') document.documentElement.dataset.bg = bg;`}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
